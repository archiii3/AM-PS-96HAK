def make_folder(path):
    if not os.path.exists(path):
        os.makedirs(path)
        print(f"Created: {path}")


def write_file(path, content):
    with open(path, 'w', encoding='utf-8') as f:
        f.write(content)
    print(f"Wrote: {path}")


