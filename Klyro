#!/usr/bin/env python3

"""
Klyro
-----
A lightweight website and API health monitor.

Features:
- Monitor multiple URLs
- Concurrent requests
- Response time measurement
- HTTP status tracking
- Automatic retries
- Timeout handling
- JSON output
- Simple terminal dashboard
- No external dependencies

Usage:
    python klyro.py https://github.com https://api.github.com

    python klyro.py https://github.com --retries 2 --timeout 5

    python klyro.py https://github.com https://example.com --json
"""

import argparse
import concurrent.futures
import json
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone


VERSION = "1.0.0"
DEFAULT_TIMEOUT = 10
DEFAULT_RETRIES = 1
MAX_WORKERS = 10

USER_AGENT = (
    "Klyro/"
    + VERSION
    + " (+https://github.com/klyro)"
)


def check_url(url, timeout=DEFAULT_TIMEOUT, retries=DEFAULT_RETRIES):
    """Check the health of a URL and return a structured result."""

    if not url.startswith(("http://", "https://")):
        url = "https://" + url

    last_error = None

    for attempt in range(retries + 1):
        start = time.perf_counter()

        try:
            request = urllib.request.Request(
                url,
                headers={
                    "User-Agent": USER_AGENT,
                    "Accept": "*/*",
                },
                method="GET",
            )

            with urllib.request.urlopen(
                request,
                timeout=timeout,
            ) as response:

                elapsed = round(
                    (time.perf_counter() - start) * 1000,
                    2,
                )

                return {
                    "url": url,
                    "status": response.status,
                    "response_ms": elapsed,
                    "ok": 200 <= response.status < 400,
                    "error": None,
                    "attempts": attempt + 1,
                }

        except urllib.error.HTTPError as error:
            elapsed = round(
                (time.perf_counter() - start) * 1000,
                2,
            )

            return {
                "url": url,
                "status": error.code,
                "response_ms": elapsed,
                "ok": False,
                "error": f"HTTP {error.code}",
                "attempts": attempt + 1,
            }

        except urllib.error.URLError as error:
            last_error = str(error.reason)

        except TimeoutError:
            last_error = "Request timed out"

        except Exception as error:
            last_error = str(error)

    elapsed = round(
        (time.perf_counter() - start) * 1000,
        2,
    )

    return {
        "url": url,
        "status": None,
        "response_ms": elapsed,
        "ok": False,
        "error": last_error or "Unknown error",
        "attempts": retries + 1,
    }


def format_result(result):
    """Format a single result for terminal output."""

    status = (
        f"HTTP {result['status']}"
        if result["status"] is not None
        else "FAILED"
    )

    latency = f"{result['response_ms']} ms"

    if result["ok"]:
        state = "OK"
    else:
        state = "DOWN"

    line = (
        f"[{state:<4}] "
        f"{status:<10} "
        f"{latency:<12} "
        f"{result['url']}"
    )

    if result["error"]:
        line += f"  ({result['error']})"

    return line


def print_summary(results, duration):
    """Print a compact monitoring summary."""

    total = len(results)
    healthy = sum(1 for item in results if item["ok"])
    failed = total - healthy

    valid_times = [
        item["response_ms"]
        for item in results
        if item["status"] is not None
    ]

    average = (
        round(sum(valid_times) / len(valid_times), 2)
        if valid_times
        else 0
    )

    print("\n" + "-" * 72)
    print("KLYRO SUMMARY")
    print("-" * 72)
    print(f"Targets      : {total}")
    print(f"Healthy      : {healthy}")
    print(f"Failed       : {failed}")
    print(f"Average time : {average} ms")
    print(f"Total time   : {round(duration * 1000, 2)} ms")
    print("-" * 72)


def run_monitor(urls, timeout, retries):
    """Run URL checks concurrently."""

    start = time.perf_counter()

    with concurrent.futures.ThreadPoolExecutor(
        max_workers=min(MAX_WORKERS, len(urls))
    ) as executor:

        futures = {
            executor.submit(
                check_url,
                url,
                timeout,
                retries,
            ): url
            for url in urls
        }

        results = []

        for future in concurrent.futures.as_completed(futures):
            results.append(future.result())

    # Keep output order consistent with the input order.
    position = {
        url: index
        for index, url in enumerate(urls)
    }

    results.sort(
        key=lambda item: position.get(item["url"], 999999)
    )

    duration = time.perf_counter() - start

    return results, duration


def parse_args():
    parser = argparse.ArgumentParser(
        description="Klyro — lightweight website and API health monitor."
    )

    parser.add_argument(
        "urls",
        nargs="+",
        help="URLs to monitor.",
    )

    parser.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        help=f"Request timeout in seconds. Default: {DEFAULT_TIMEOUT}",
    )

    parser.add_argument(
        "--retries",
        type=int,
        default=DEFAULT_RETRIES,
        help=f"Number of retries. Default: {DEFAULT_RETRIES}",
    )

    parser.add_argument(
        "--json",
        action="store_true",
        help="Return results as JSON.",
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"Klyro {VERSION}",
    )

    return parser.parse_args()


def main():
    args = parse_args()

    if args.timeout <= 0:
        print("Error: timeout must be greater than zero.")
        sys.exit(2)

    if args.retries < 0:
        print("Error: retries cannot be negative.")
        sys.exit(2)

    print(
        f"\nKlyro {VERSION} — checking {len(args.urls)} target(s)...\n"
    )

    results, duration = run_monitor(
        args.urls,
        args.timeout,
        args.retries,
    )

    if args.json:
        output = {
            "tool": "klyro",
            "version": VERSION,
            "checked_at": datetime.now(
                timezone.utc
            ).isoformat(),
            "summary": {
                "total": len(results),
                "healthy": sum(
                    1 for item in results if item["ok"]
                ),
                "failed": sum(
                    1 for item in results if not item["ok"]
                ),
                "duration_ms": round(
                    duration * 1000,
                    2,
                ),
            },
            "results": results,
        }

        print(json.dumps(output, indent=2))

    else:
        for result in results:
            print(format_result(result))

        print_summary(results, duration)

    # Exit with a non-zero code when at least one target fails.
    if any(not item["ok"] for item in results):
        sys.exit(1)


if __name__ == "__main__":
    main()
